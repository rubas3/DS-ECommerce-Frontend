MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ecommerce

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=ecommerce-frontend
DEFAULT_PRODUCT_STOCK=100

# Existing Firebase variables are still required for auth.
# Add your own Firebase Admin credentials as already configured in your project.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
